manifest {
    name = 'abhijitswain09/NGS-data-analysis'
    author = 'Abhijit Swain'
    homePage = 'https://github.com/abhijitswain09/NGS-data-analysis'
    description = 'Paired-end RNA-seq QC, alignment, counting, GO/GSEA, and co-expression network analysis'
    mainScript = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version = '2.1.0'
}
params {
    input = null
    fasta = null
    gtf = null
    adapters = "${projectDir}/assets/TruSeq3-PE.fa"
    outdir = 'results'
    min_len = 36
    strandedness = 'no'
    gtf_attribute = 'gene_id'
    contrast_reference = 'control'
    contrast_target = 'treatment'
    padj = 0.05
    lfc = 1
    skip_go = false
    go_annotation_url = 'https://current.geneontology.org/annotations/gaf/HUMAN-uniprot.gaf.gz'
    go_obo_url = 'https://current.geneontology.org/ontology/go-basic.obo'
    run_wgcna = false
}
process {
    cpus = 2
    memory = 4.GB
    time = 4.h
    withLabel: process_low { cpus = 2; memory = 4.GB }
    withLabel: process_medium { cpus = 4; memory = 8.GB }
    withLabel: process_high { cpus = 8; memory = 16.GB }
    publishDir = [path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" }, mode: 'copy']
    withName: 'DESEQ2|EDGER' { publishDir = [path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" }, mode: 'copy'] }
}
profiles {
    conda {
        conda.enabled = true
        conda.channels = ['conda-forge', 'bioconda']
    }
    docker {
        docker.enabled = true
        wave.enabled = true
        wave.strategy = ['conda']
    }
    test { includeConfig 'conf/test.config' }
}
timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html" }
trace { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.txt" }
